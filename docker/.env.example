# OPCIONAL. Sin este archivo todo queda dentro de docker/data/ y no hay que configurar nada.
# Copialo a .env y descomentá solo lo que quieras mover (por ejemplo a un disco con más espacio).
# Las rutas relativas son relativas a la carpeta docker/.

# Tu usuario en el equipo (`id -u` y `id -g`). Por defecto 1000, que es el primer usuario en Linux.
# STEMSHED_UID=1000
# STEMSHED_GID=1000

# Tu música (solo lectura). Por defecto docker/data/music: copiá o enlazá ahí tus carpetas, o apuntá a la tuya.
# STEMSHED_MUSIC=./data/music

# Perfiles, memoria y sesión de TIDAL.
# STEMSHED_CONFIG=./data/config
# Stems y análisis.
# STEMSHED_DATA=./data/stemshed
# Entorno de separación (≈ 8 GB; se instala desde Ajustes).
# STEMSHED_ENV=./data/env
# Modelo de separación (≈ 700 MB; se descarga desde Ajustes).
# STEMSHED_SEP_MODELS=./data/models/separation
# Modelos de recomendación (varios GB; se descargan desde Ajustes).
# STEMSHED_LLM_MODELS=./data/models/ollama

# Puertos (solo en este equipo, 127.0.0.1).
# STEMSHED_WEB_PORT=5173
# STEMSHED_ENGINE_PORT=8770

# Si la web se publica en otro dominio, agregalo acá (separado por comas): solo esos orígenes pueden hablarle al motor.
# STEMSHED_ORIGINS=http://127.0.0.1:5173
