# Copiá este archivo a .env y ajustá las rutas. Nada de esto se sube a ningún lado.
STEMSHED_UID=1000
STEMSHED_GID=1000
STEMSHED_MUSIC=/home/vos/Musica                  # tu música (solo lectura)
STEMSHED_CONFIG=./data/config                    # perfiles, memoria, sesión de TIDAL
STEMSHED_DATA=./data/stemshed                    # stems y análisis
STEMSHED_ENV=./data/env                          # entorno de separación (varios GB; se instala desde Ajustes)
STEMSHED_SEP_MODELS=./data/models/separation     # modelos de separación (se descargan desde Ajustes)
STEMSHED_LLM_MODELS=./data/models/ollama         # modelos de recomendación (se descargan desde Ajustes)
STEMSHED_WEB_PORT=5173
# Si la web se publica en otro dominio, agregalo acá (separado por comas): solo esos orígenes pueden hablarle al motor.
STEMSHED_ORIGINS=http://127.0.0.1:5173
