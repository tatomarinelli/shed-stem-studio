{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shed Stem Studio",
  "version": "0.0.3",
  "identifier": "app.shedstemstudio.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/stage/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
